# AI Student Assistance — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is listed in .gitignore.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Generate strong random values for production (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-to-a-super-secret-key-in-production
JWT_SECRET_KEY=change-me-to-a-jwt-secret-key-in-production

# ── Database ──────────────────────────────────────────────────────────────────
# Leave DATABASE_URL blank to use SQLite (recommended for local dev).
# PostgreSQL example: postgresql://user:password@localhost:5432/student_assistance
DATABASE_URL=

# Absolute path for the SQLite database file.
# On Render, set this to: /opt/render/project/src/student_assistance.db
# Leave blank locally — the app will use backend/student_assistance.db by default.
SQLITE_PATH=

# ── AI Integration ────────────────────────────────────────────────────────────
# Optional. Leave blank to use the built-in Smart Heuristic Extraction Engine.
GEMINI_API_KEY=

# ── Demo Account Seeding ──────────────────────────────────────────────────────
# Set to "true" ONLY if you want a demo account auto-created on a fresh empty DB.
# Disabled by default. Do NOT enable in production without understanding the risk.
SEED_DEMO_ACCOUNT=false
