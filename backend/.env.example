# AI Student Assistance - Environment Configuration

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-super-secret-key-in-production
JWT_SECRET_KEY=change-me-to-a-jwt-secret-key-in-production
PORT=5000

# Database Configuration (PostgreSQL supported; defaults to local SQLite if empty or unreachable)
# Example for PostgreSQL: postgresql://postgres:postgres@localhost:5432/student_assistance
DATABASE_URL=

# AI Integration Keys (Optional: Leave blank to use built-in Smart Heuristic Extraction engine)
GEMINI_API_KEY=
